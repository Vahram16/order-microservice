{
  "Security": {
    "Audience": "order-api",
    "RoleClientId": "order-api",
    "ValidAuthorizedParties": [
      "order-mobile"
    ],
    "RequiredClaims": [
      "sub",
      "iat",
      "jti"
    ],
    "MapRealmRoles": false,
    "NameClaimType": "preferred_username",
    "RequireHttpsMetadata": true,
    "ClockSkew": "00:00:30",
    "ValidTokenTypes": [
      "JWT",
      "at+jwt"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
