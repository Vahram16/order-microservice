{
  "AuthorizationServer": {
    "AuthorizationCodeLifetime": "00:02:00",
    "AccessTokenLifetime": "00:10:00",
    "IdentityTokenLifetime": "00:05:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "Scopes": [
      {
        "Name": "flight.read",
        "DisplayName": "Search and view flights",
        "Resource": "booking-public-api"
      },
      {
        "Name": "booking.read",
        "DisplayName": "View the customer's bookings",
        "Resource": "booking-public-api"
      },
      {
        "Name": "booking.create",
        "DisplayName": "Create bookings",
        "Resource": "booking-public-api"
      },
      {
        "Name": "booking.cancel",
        "DisplayName": "Cancel the customer's bookings",
        "Resource": "booking-public-api"
      },
      {
        "Name": "passenger.self.read",
        "DisplayName": "View the customer's passenger profile",
        "Resource": "booking-public-api"
      },
      {
        "Name": "passenger.self.update",
        "DisplayName": "Update the customer's passenger profile",
        "Resource": "booking-public-api"
      },
      {
        "Name": "identity.profile.read",
        "DisplayName": "View the customer's identity profile",
        "Resource": "identity-api"
      }
    ],
    "CorsOrigins": [],
    "Clients": []
  },
  "IdentityInteraction": {
    "LoginPath": "/account/login",
    "LogoutPath": "/account/logout",
    "AccessDeniedPath": "/account/access-denied",
    "InteractionTokenLifetime": "00:03:00"
  },
  "IdentityPasswordPolicy": {
    "MinimumBlocklistEntries": 10000,
    "RejectUserInputs": true
  },
  "IdentityNotifications": {
    "Provider": "None",
    "DispatchInterval": "00:00:05",
    "LeaseDuration": "00:02:00",
    "DeduplicationWindow": "00:05:00",
    "BatchSize": 20,
    "MaximumAttempts": 12
  },
  "IdentityMaintenance": {
    "PruneInterval": "00:15:00",
    "MinimumAge": "01:00:00",
    "FailureRetryInterval": "00:01:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "OpenIddict": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
