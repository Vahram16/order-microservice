{
  "ConnectionStrings": {
    "identity-db": "Host=localhost;Port=5432;Database=identity;Username=postgres;Password=postgres"
  },
  "AuthorizationServer": {
    "Issuer": "https://localhost:7100/",
    "UseEphemeralKeysInDevelopment": true,
    "CorsOrigins": [
      "https://localhost:7443"
    ],
    "Clients": [
      {
        "ClientId": "booking-web",
        "DisplayName": "Booking customer web application",
        "Profile": "Public",
        "AllowRefreshTokens": true,
        "RequirePushedAuthorizationRequests": false,
        "RedirectUris": [
          "https://localhost:7443/authentication/login-callback"
        ],
        "PostLogoutRedirectUris": [
          "https://localhost:7443/authentication/logout-callback"
        ],
        "Scopes": [
          "openid",
          "profile",
          "email",
          "offline_access",
          "flight.read",
          "booking.read",
          "booking.create",
          "booking.cancel",
          "passenger.self.read",
          "passenger.self.update",
          "identity.profile.read"
        ]
      }
    ]
  },
  "IdentityNotifications": {
    "Provider": "DevelopmentLog",
    "PublicOrigin": "https://localhost:7100/"
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "OpenIddict": "Information"
    }
  }
}
